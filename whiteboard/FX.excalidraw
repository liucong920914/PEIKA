      "boundElements": [],
      "updated": 1773218880759,
      "link": null,
      "locked": false,
      "text": "命中\n未命中\n命中\n……（假设都没命中）\n命中",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "命中\n未命中\n命中\n……（假设都没命中）\n命中",
