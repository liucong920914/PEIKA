      "link": null,
      "locked": false,
      "text": "用户域先定义，在MPS2.0钱包页中，给用户展示\n哪些[业务类型-2]",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "z0Smp96yeNze9T7HGl9yl",
      "originalText": "用户域先定义，在MPS2.0钱包页中，给用户展示哪些[业务类型-2]",
